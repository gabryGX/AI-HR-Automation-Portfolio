    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = $input.all().map(i => i.json).filter(r => r.Workflow);   // يتجاهل الصفوف الفاضية\n\nconst now = DateTime.now().setZone('Africa/Cairo');\nconst parse = t => DateTime.fromFormat(String(t || '').trim(), 'yyyy-MM-dd H:mm', { zone: 'Africa/Cairo' });\nconst isCrit = r => String(r.Severity || '').toLowerCase() === 'critical';\n\n// 1) آخر 24 ساعة\nconst last24 = rows.filter(r => {\n  const t = parse(r.Time);\n  return t.isValid && now.diff(t, 'hours').hours <= 24;\n});\n\n// 2) المفتوح (من أي وقت)\nconst open = rows.filter(r => String(r.Status || '').toLowerCase() === 'open');\n\n// 3) تفصيل الـ 24 ساعة حسب النوع\nconst byType = {};\nfor (const r of last24) {\n  const k = r.Type || 'unknown';\n  byType[k] = (byType[k] || 0) + 1;\n}\nconst typeRows = Object.entries(byType)\n  .sort((a, b) => b[1] - a[1])\n  .map(([k, n]) => `<li><b>${esc(k)}</b>: ${n}</li>`)\n  .join('');\n\n// 4) المفتوح مجمّع بالـ Fingerprint\nconst groups = {};\nfor (const r of open) {\n  const key = r.Fingerprint || `${r.Workflow} | ${r.Node} | ${r.Type}`;\n  if (!groups[key]) groups[key] = { ...r, times: 0 };\n  groups[key].times++;\n}\nconst openRows = Object.values(groups)\n  .sort((a, b) => (isCrit(b) - isCrit(a)) || (b.times - a.times))\n  .map(g => `<li><b>${esc(g.Workflow)}</b> at ${esc(g.Node)} (${esc(g.Type)}, ${esc(g.Severity)}) &times;${g.times}<br><span style=\"color:#6b7280;\">${esc(g.Message)}</span><br><i>${esc(g['Suggested Fix'])}</i></li>`)\n  .join('');\n\nreturn [{ json: {\n  hasNews: last24.length > 0 || open.length > 0,\n  total24h: last24.length,\n  critical24h: last24.filter(isCrit).length,\n  openCount: open.length,\n  typeListHtml: typeRows || '<li>No new errors.</li>',\n  openListHtml: openRows || '<li>Nothing open. Good job.</li>'\n}}];"
      },
