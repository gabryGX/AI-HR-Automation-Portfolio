{
  "name": "Policy Loader",
  "nodes": [
    {
      "parameters": {
        "events": [
          "init"
        ]
      },
      "type": "n8n-nodes-base.n8nTrigger",
      "typeVersion": 1,
      "position": [
        -736,
        48
      ],
      "id": "4edf07fc-a52f-4475-ae78-cf762a6986a2",
      "name": "When n8n Starts"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -736,
        224
      ],
      "id": "ef5fcc2d-6f68-45da-85a4-302b5847e1bd",
      "name": "Every Morning 7 AM"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -736,
        400
      ],
      "id": "24934dcf-5cff-4c26-9ee4-6ad468311bd7",
      "name": "Reload Now"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_ID",
            "mode": "list",
            "cachedResultName": "Gbry HR Policies"
          },
          "whatToSearch": "files"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -432,
        224
      ],
      "id": "a16dc862-ad00-4b43-881a-c53985db32eb",
      "name": "List Policy Files",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -176,
        224
      ],
      "id": "ec2170de-2bc0-4580-bcb1-bd84384e6c01",
      "name": "Download Policy"
    },
    {
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "value": "hr_policies",
          "mode": "id"
        },
        "clearStore": true
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.4,
      "position": [
        112,
        224
      ],
      "id": "d39b2f0a-cefc-4521-98cb-03a071d4223e",
      "name": "Reload Knowledge Base"
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        64,
        448
      ],
      "id": "c6842f56-ee5b-4137-aae6-b0de9c1ef4b0",
      "name": "Gemini Embeddings"
    },
    {
      "parameters": {
        "dataType": "binary",
        "textSplittingMode": "custom",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        288,
        448
      ],
      "id": "6d6c8dbf-db72-4967-aaf9-2c002a02cb66",
      "name": "Read Policy Text"
    },
    {
      "parameters": {
        "chunkOverlap": 200,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        416,
        608
      ],
      "id": "b1b00822-0132-4977-ac62-98bb0416f321",
      "name": "Split Into Chunks"
    }
  ],
  "connections": {
    "When n8n Starts": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Morning 7 AM": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reload Now": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Policy Files": {
      "main": [
        [
          {
            "node": "Download Policy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Policy": {
      "main": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Read Policy Text": {
      "ai_document": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Split Into Chunks": {
      "ai_textSplitter": [
        [
          {
            "node": "Read Policy Text",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "nodeGroups": []
}